# Copy to .env on the server. Never commit .env.
# Generate values with:
#   .venv/bin/invoices secret-key
#   .venv/bin/invoices hash-password
INVOICES_SECRET_KEY=
INVOICES_USERNAME=admin
# Wrap in single quotes: the hash contains '$'.
INVOICES_PASSWORD_HASH=''
# Minimum years to keep archived invoices and documents, counted from the end of the year; nothing
# is ever deleted. Buchungsbelege need 8 years since 2025; 10 is a deliberate conservative default
# (docs/GOBD.md, "Retention").
INVOICES_RETENTION_YEARS=10
# Year the business started. § 19 UStG applies a 25,000 € limit to the founding year itself;
# leave empty only if unknown (the turnover monitor then warns).
INVOICES_FOUNDING_YEAR=
# Number of most recent daily backups to keep (plus one per month, forever).
INVOICES_BACKUP_KEEP=30
