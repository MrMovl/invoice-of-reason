# Copy to .env on the server. Never commit .env.
# Generate values with:
#   .venv/bin/invoices secret-key
#   .venv/bin/invoices hash-password
INVOICES_SECRET_KEY=
INVOICES_USERNAME=admin
# Wrap in single quotes: the hash contains '$'.
INVOICES_PASSWORD_HASH=''
# Years to keep archived invoices, counted from the end of the issue year.
INVOICES_RETENTION_YEARS=10
# Number of most recent daily backups to keep (plus one per month, forever).
INVOICES_BACKUP_KEEP=30
